-# _existing KEY: current value of KEY in ENV_FILE, if any, with write_env's single
-# quotes or a plain dotenv double-quoted value undone.
+_dotenv_quoted_value() {
+  local text="$1" quote="$2" char suffix legacy_escape="'\\''" index=0
+  _DOTENV_QUOTED_VALUE=""
+  _DOTENV_QUOTE_STATE="open"
+  while (( index < ${#text} )); do
+    char="${text:index:1}"
+    if [[ "$char" == "$quote" ]]; then
+      if [[ "$quote" == "'" && "${text:index:4}" == "$legacy_escape" ]]; then
+        _DOTENV_QUOTED_VALUE+="'"
+        index=$((index + 4))
+        continue
+      fi
+      suffix="${text:index+1}"
+      if [[ "$suffix" =~ ^[[:space:]]*(#.*)?$ ]]; then
+        _DOTENV_QUOTE_STATE="closed"
+      else
+        _DOTENV_QUOTE_STATE="invalid"
+      fi
+      return 0
+    fi
+    _DOTENV_QUOTED_VALUE+="$char"
+    index=$((index + 1))
+  done
+  return 0
+}
