+  _EXISTING_ENV_VALUE=""
+  while IFS= read -r line || [[ -n "$line" ]]; do
+    [[ "$line" == "$key="* ]] || continue
+    raw="${line#*=}"
+    if [[ "$raw" == \'* || "$raw" == \"* || "$raw" == \`* ]]; then
+      quote="${raw:0:1}"
+      value="${raw:1}"
+      while :; do
+        _dotenv_quoted_value "$value" "$quote"
+        if [[ "$_DOTENV_QUOTE_STATE" == "closed" ]]; then
